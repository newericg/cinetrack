{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedOrigins": {
    "Frontend": "http://localhost:4200"
  },
  "MongoDB": {
    "ConnectionString": "YOUR_MONGODB_ATLAS_CONNECTION_STRING",
    "DatabaseName": "cinetrack-dev"
  },
  "Jwt": {
    "Secret": "dev-secret-key-replace-in-production-min32chars",
    "Issuer": "cinetrack-api",
    "Audience": "cinetrack-frontend",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  }
}
