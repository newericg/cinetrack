{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AllowedOrigins": {
    "Frontend": "http://localhost:4200"
  },
  "MongoDB": {
    "ConnectionString": "MONGO_CONNECTION_STRING_HERE",
    "DatabaseName": "cinetrack"
  },
  "Jwt": {
    "Secret": "JWT_SECRET_HERE_MIN_32_CHARS_REPLACE_ME",
    "Issuer": "cinetrack-api",
    "Audience": "cinetrack-frontend",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  }
}
